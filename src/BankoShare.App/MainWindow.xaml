<Window x:Class="BankoShare.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Banko Share" Width="740" Height="820" MinWidth="640" MinHeight="640"
 Background="#101827" Foreground="#EAF1FF" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,8,10,8"/><Setter Property="Background" Value="#83E3CB"/><Setter Property="Foreground" Value="#101827"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,6,0,10"/><Setter Property="Background" Value="#202D42"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#40516B"/><Setter Property="CaretBrush" Value="White"/></Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30">
  <TextBlock Text="BANKO SHARE" Foreground="#83E3CB" FontWeight="Bold" FontSize="13"/>
  <TextBlock Text="İki bilgisayar. Tek klavye ve fare." FontSize="27" FontWeight="SemiBold" Margin="0,10,0,8"/>
  <TextBlock Text="Windows önizlemesi · Aynı yerel ağ · F12 ile kontrol değiştir" Foreground="#AABBD3"/>
  <Border Background="#1B293D" CornerRadius="10" Padding="18" Margin="0,18,0,0"><StackPanel>
   <DockPanel><TextBlock Text="Güncellemeler" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" HorizontalAlignment="Right" Foreground="#83E3CB"/></DockPanel>
   <TextBlock x:Name="UpdateStatus" Text="Güncelleme kontrolü bekleniyor." TextWrapping="Wrap" Margin="0,8,0,0"/>
   <TextBlock x:Name="LastCheckText" Foreground="#AABBD3" FontSize="12" Margin="0,4,0,8"/>
   <CheckBox x:Name="AutoUpdate" Content="Güncellemeleri otomatik indir ve oturum yokken kur" Foreground="#EAF1FF" Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed"/>
   <WrapPanel><Button x:Name="CheckUpdateButton" Content="Şimdi kontrol et" Click="CheckUpdate_Click"/><Button x:Name="ApplyUpdateButton" Content="Güncelle ve yeniden başlat" Click="ApplyUpdate_Click" IsEnabled="False"/></WrapPanel>
  </StackPanel></Border>
  <Border Background="#1B293D" CornerRadius="10" Padding="18" Margin="0,22,0,14"><StackPanel>
   <TextBlock Text="1 / Kontrol edilecek bilgisayar" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock Text="Alıcıyı başlatın. Adresi ve eşleştirme kodunu diğer bilgisayara girin." TextWrapping="Wrap" Margin="0,7,0,0"/>
   <Button x:Name="ListenButton" Content="Alıcıyı başlat" Click="Listen_Click" HorizontalAlignment="Left"/>
   <TextBlock x:Name="AddressText" Text="Bağlantı noktası: 24819" Foreground="#AABBD3" TextWrapping="Wrap"/>
   <TextBox x:Name="PairCode" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Alıcı eşleştirme kodu"/>
   <TextBlock Text="Kod, bu oturumda bilgisayarı kontrol etme yetkisi verir. Yalnızca kendi cihazınızda kullanın." TextWrapping="Wrap" Foreground="#AABBD3" FontSize="12"/>
  </StackPanel></Border>
  <Border Background="#1B293D" CornerRadius="10" Padding="18"><StackPanel>
   <TextBlock Text="2 / Bu bilgisayardan kontrol et" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock Text="Alıcının yerel IP adresi" Margin="0,10,0,0"/>
   <TextBox x:Name="HostBox" AutomationProperties.Name="Alıcı IP adresi"/>
   <TextBlock Text="Alıcıdaki eşleştirme kodu"/>
   <TextBox x:Name="CodeBox" AutomationProperties.Name="Eşleştirme kodu"/>
   <WrapPanel><Button x:Name="ConnectButton" Content="Güvenli bağlan" Click="Connect_Click"/><Button x:Name="ControlButton" Content="Kontrolü aç (F12)" Click="Control_Click" IsEnabled="False"/></WrapPanel>
  </StackPanel></Border>
  <WrapPanel Margin="0,10,0,0"><Button x:Name="StopButton" Content="Bağlantıyı durdur" Click="Stop_Click" IsEnabled="False"/></WrapPanel>
  <TextBlock x:Name="StatusText" Text="Hazır. İki bilgisayarda da Banko Share uygulamasını açın." TextWrapping="Wrap" Foreground="#83E3CB"/>
  <TextBlock Text="F12: yerel / uzak kontrol. Alıcıda fiziksel F12: oturumu sonlandır. Yönetici pencereleri ve kilit ekranı bu önizlemede desteklenmez." TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#AABBD3" FontSize="12"/>
 </StackPanel></ScrollViewer>
</Window>
