<Window x:Class="BankoShare.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:BankoShare.App"
 Title="Banko Share" Icon="BankoShare.ico" Width="1040" Height="720" MinWidth="860" MinHeight="600" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource Base}" Foreground="{DynamicResource Text}" FontFamily="Inter, Segoe UI Variable Text, Segoe UI" FontSize="14"
 TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
 <Window.Resources>
  <!-- BankoSpace "Noir" design system -->
  <SolidColorBrush x:Key="Base" Color="#1A1A1A"/>
  <SolidColorBrush x:Key="CardFill" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="Elevated" Color="#2A2A2A"/>
  <SolidColorBrush x:Key="Hover" Color="#313131"/>
  <SolidColorBrush x:Key="Line" Color="#333333"/>
  <SolidColorBrush x:Key="LineHover" Color="#444444"/>
  <SolidColorBrush x:Key="Divider" Color="#262626"/>
  <SolidColorBrush x:Key="Text" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="TextSecondary" Color="#B0B0B0"/>
  <SolidColorBrush x:Key="TextMuted" Color="#727272"/>
  <SolidColorBrush x:Key="Green" Color="#7EE787"/>
  <SolidColorBrush x:Key="GreenWash" Color="#267EE787"/>
  <SolidColorBrush x:Key="GreenPress" Color="#407EE787"/>
  <SolidColorBrush x:Key="Warning" Color="#D29922"/>

  <Style TargetType="Button">
   <Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,10,10,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Green}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Green}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
     CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource GreenWash}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource GreenPress}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource Elevated}"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
     CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Hover}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource LineHover}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,6,0,10"/><Setter Property="Background" Value="{StaticResource Base}"/>
   <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CaretBrush" Value="{StaticResource Text}"/><Setter Property="SelectionBrush" Value="{StaticResource Green}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
     <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource LineHover}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Green}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="HotkeyBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="IsReadOnlyCaretVisible" Value="False"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Margin" Value="0,4"/><Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
   <EventSetter Event="PreviewKeyDown" Handler="Hotkey_PreviewKeyDown"/>
   <EventSetter Event="GotKeyboardFocus" Handler="Hotkey_GotFocus"/>
   <EventSetter Event="LostKeyboardFocus" Handler="Hotkey_LostFocus"/>
  </Style>

  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1" BorderBrush="{StaticResource LineHover}" Background="{StaticResource Base}" VerticalAlignment="Center">
      <Path x:Name="Mark" Data="M 3.5,9 L 7.2,12.5 L 14,5" Stroke="{StaticResource Base}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/></Border>
     <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextMuted}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Green}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Green}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,8,24,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Grid Width="18" Height="18" VerticalAlignment="Center">
      <Ellipse x:Name="Ring" Stroke="{StaticResource LineHover}" StrokeThickness="1" Fill="{StaticResource Base}"/>
      <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource Green}" Visibility="Collapsed"/></Grid>
     <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{StaticResource TextMuted}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Green}"/><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="10"/><Setter Property="MinWidth" Value="10"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Track x:Name="PART_Track" IsDirectionReversed="True">
     <Track.Thumb><Thumb Margin="2,2"><Thumb.Template><ControlTemplate TargetType="Thumb">
      <Border x:Name="T" CornerRadius="3" Background="#3A3A3A"/>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#4A4A4A"/></Trigger></ControlTemplate.Triggers>
     </ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Row" CornerRadius="5" Padding="10,6" Margin="2,1" Background="Transparent"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#282828"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#2F2F2F"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource TextMuted}"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ContextMenu">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
    <Border Background="{StaticResource Elevated}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="4">
     <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem">
   <Setter Property="Foreground" Value="{StaticResource Text}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Border x:Name="Row" CornerRadius="5" Padding="10,6" Background="Transparent"><ContentPresenter ContentSource="Header"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource TextMuted}"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource CardFill}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20,18"/><Setter Property="Margin" Value="0,0,0,14"/>
  </Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontWeight" Value="Medium"/><Setter Property="Margin" Value="0,18,0,0"/></Style>
  <Style x:Key="Note" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,0,0"/><Setter Property="LineHeight" Value="19"/></Style>
  <Style x:Key="Nav" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#767676"/><Setter Property="FontSize" Value="13.5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="GroupName" Value="Nav"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Box" CornerRadius="6" Padding="12,7,10,7" Margin="0,1" Background="Transparent"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#282828"/><Setter Property="Foreground" Value="#C6C6C6"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#2F2F2F"/><Setter Property="Foreground" Value="#EDEDED"/><Setter Property="FontWeight" Value="Medium"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>

 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <Border Grid.RowSpan="2" Background="{StaticResource Base}" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,0">
   <DockPanel Margin="10,22,10,16">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
      <Image Source="BankoShare.ico" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
      <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
       <TextBlock Text="Banko Share" FontWeight="SemiBold" FontSize="15"/>
       <TextBlock x:Name="VersionText" Foreground="{StaticResource TextMuted}" FontSize="11.5"/>
      </StackPanel>
     </StackPanel>
     <TextBlock x:Name="LocalNameText" Margin="12,18,0,6" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
     <RadioButton x:Name="NavDevices" Style="{StaticResource Nav}" Content="Cihazlar" IsChecked="True" Checked="Nav_Checked"/>
     <RadioButton x:Name="NavLayout" Style="{StaticResource Nav}" Content="Monitör düzeni" Checked="Nav_Checked"/>
     <RadioButton x:Name="NavSwitching" Style="{StaticResource Nav}" Content="Geçiş ayarları" Checked="Nav_Checked"/>
     <RadioButton x:Name="NavUpdates" Style="{StaticResource Nav}" Content="Uygulama" Checked="Nav_Checked"/>
    </StackPanel>
    <Border VerticalAlignment="Bottom" Margin="6,0" Padding="12,10" CornerRadius="8" Background="{StaticResource CardFill}" BorderBrush="{StaticResource Line}" BorderThickness="1">
     <TextBlock Style="{StaticResource Note}" FontSize="12" Margin="0" LineHeight="17"
      Text="Esc tuşuna hızlıca iki kez basmak imleci ve klavyeyi bu bilgisayara geri getirir."/>
    </Border>
   </DockPanel>
  </Border>

  <Grid Grid.Column="1">
   <ScrollViewer x:Name="DevicesPanel" VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,28,32,24">
    <TextBlock Text="Cihazlar" Style="{StaticResource Title}"/>
    <TextBlock Style="{StaticResource Note}" Margin="0,6,0,20"
     Text="Fare ve klavyeyi paylaşan bilgisayarlar. Eşleştirme bir kez yapılır; sonra iki uygulama açıldığında kendiliğinden bağlanır."/>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="Bu bilgisayar" Style="{StaticResource Heading}"/>
     <TextBlock x:Name="LocalInfoText" Style="{StaticResource Note}"/>
     <TextBlock x:Name="WarningText" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="Eşleşmiş cihazlar" Style="{StaticResource Heading}"/>
     <StackPanel x:Name="PeersPanel" Margin="0,10,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Bu bilgisayarı ekle" Style="{StaticResource Heading}"/>
      <TextBlock Style="{StaticResource Note}" Text="Kodu gösterin ve diğer bilgisayardaki Banko Share'e girin. Her basışta yeni kod üretilir; kod 5 dakika geçerlidir ve bir kez kullanılır."/>
      <Button x:Name="ShowCodeButton" Content="Eşleştirme kodu göster" Click="ShowCode_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
      <StackPanel x:Name="CodePanel" Visibility="Collapsed" Margin="0,14,0,0">
       <Border Background="{StaticResource Base}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18,8" HorizontalAlignment="Left">
        <TextBox x:Name="PairCodeText" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource Green}"
         Background="Transparent" BorderThickness="0" Padding="0" Margin="0" AutomationProperties.Name="Eşleştirme kodu"/>
       </Border>
       <TextBlock x:Name="PairExpiryText" Style="{StaticResource Note}"/>
       <WrapPanel>
        <Button Content="Yeni kod" Style="{StaticResource Secondary}" Click="ShowCode_Click"/>
        <Button Content="Kodu iptal et" Style="{StaticResource Secondary}" Click="CancelCode_Click"/>
       </WrapPanel>
      </StackPanel>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="Diğer bilgisayarı ekle" Style="{StaticResource Heading}"/>
      <TextBlock Text="Ağda bulunan Banko Share cihazları" Style="{StaticResource Note}"/>
      <Border Margin="0,8,0,0" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="{StaticResource Base}">
       <ListBox x:Name="DiscoveredList" Height="92" SelectionChanged="Discovered_Selected" Background="Transparent" BorderThickness="0" Padding="2"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
      </Border>
      <TextBlock Text="IP adresi" Margin="0,12,0,0" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
      <TextBox x:Name="AddressBox" AutomationProperties.Name="Diğer bilgisayarın IP adresi"/>
      <TextBlock Text="Diğer bilgisayarda görünen 6 haneli kod" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
      <TextBox x:Name="CodeBox" FontFamily="Cascadia Mono, Consolas" FontSize="20" MaxLength="9" Width="160" HorizontalAlignment="Left"
       KeyDown="CodeBox_KeyDown" AutomationProperties.Name="Eşleştirme kodu girişi"/>
      <Button x:Name="PairButton" Content="Eşleştir" Click="Pair_Click" HorizontalAlignment="Left" Margin="0,0,10,0"/>
      <TextBlock x:Name="PairStatusText" Style="{StaticResource Note}"/>
     </StackPanel>
    </Grid></Border>
   </StackPanel></ScrollViewer>

   <Grid x:Name="LayoutPanel" Visibility="Collapsed" Margin="32,28,32,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="Monitör düzeni" Style="{StaticResource Title}"/>
     <TextBlock Style="{StaticResource Note}" Margin="0,6,0,16"
      Text="Monitörleri masanızdaki yerleşime göre sürükleyin. Bir bilgisayarın monitörleri birlikte taşınır ve yakındaki kenara yapışır. İmleç, birbirine değen kenarlardan diğer bilgisayara geçer."/>
    </StackPanel>
    <Border Grid.Row="1" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource Line}" ClipToBounds="True">
     <local:LayoutEditor x:Name="Editor" MinHeight="260"/>
    </Border>
    <DockPanel Grid.Row="2" Margin="0,12,0,0">
     <Button DockPanel.Dock="Right" Content="Düzeni sıfırla" Style="{StaticResource Secondary}" Click="ResetLayout_Click" Margin="10,0,0,0" VerticalAlignment="Top"/>
     <StackPanel>
      <TextBlock x:Name="LayoutHintText" Style="{StaticResource Note}" Margin="0"/>
      <TextBlock Style="{StaticResource Note}" FontSize="12"><Run Foreground="#7EE787" Text="■"/> Bu bilgisayar   <Run Foreground="#C9C9C9" Text="■"/> Bağlı   <Run Foreground="#444444" Text="■"/> Bağlı değil</TextBlock>
     </StackPanel>
    </DockPanel>
   </Grid>

   <ScrollViewer x:Name="SwitchingPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,28,32,24">
    <TextBlock Text="Geçiş ayarları" Style="{StaticResource Title}"/>
    <TextBlock Style="{StaticResource Note}" Margin="0,6,0,20"
     Text="Bu ayarlar, imleci bu bilgisayarın faresi ve klavyesiyle yönetirken geçerlidir. Diğer bilgisayar kendi ayarlarını kullanır."/>

    <Border Style="{StaticResource Card}"><StackPanel>
     <CheckBox x:Name="SwitchingBox" Content="Ekran kenarından diğer bilgisayara geç" FontWeight="Medium" Checked="Option_Changed" Unchecked="Option_Changed"/>
     <TextBlock Style="{StaticResource Note}" Margin="28,4,0,0" Text="Kapalıyken imleç kenardan geçmez, kısayollar çalışmaya devam eder. Bağlantılar açık kalır ve diğer bilgisayar buraya geçebilir."/>
     <CheckBox x:Name="EqualizeBox" Content="Ekran boyutlarını eşitle" Margin="0,16,0,0" Checked="Option_Changed" Unchecked="Option_Changed"/>
     <TextBlock Style="{StaticResource Note}" Margin="28,4,0,0" Text="Kenarın tamamı karşısındaki kenarın tamamına orantılı eşlenir. Boyutları farklı monitörler arasında kenarın her yerinden geçilir."/>
     <CheckBox x:Name="WrapBox" Content="İmleci ekranların etrafında döndür" Margin="0,16,0,0" Checked="Option_Changed" Unchecked="Option_Changed"/>
     <TextBlock Style="{StaticResource Note}" Margin="28,4,0,0" Text="Düzenin dış kenarından çıkan imleç, aynı satırın ya da sütunun öbür ucundan girer."/>
    </StackPanel></Border>

    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="Geçişi engelle" Style="{StaticResource Heading}"/>
     <TextBlock Style="{StaticResource Note}" Text="Engel varken imleç kenarda durur ve nedeni durum çubuğunda yazar. Pencere koşulları bu bilgisayardan çıkarken denetlenir; köşe, tuş ve çift dokunma her geçişte geçerlidir."/>
     <CheckBox x:Name="FullscreenBox" Content="Tam ekran bir uygulama öndeyken (oyun, sunum, video)" Margin="0,14,0,0" Checked="Option_Changed" Unchecked="Option_Changed"/>
     <CheckBox x:Name="MaximizedBox" Content="Büyütülmüş bir pencere öndeyken" Margin="0,12,0,0" Checked="Option_Changed" Unchecked="Option_Changed"/>
     <TextBlock Style="{StaticResource Note}" Margin="28,2,0,0" Text="Yalnızca imlecin çıktığı monitördeki pencere sayılır."/>
     <CheckBox x:Name="CornersBox" Content="Ekran köşelerinde" Margin="0,12,0,0" Checked="Option_Changed" Unchecked="Option_Changed"/>
     <TextBlock Style="{StaticResource Note}" Margin="28,2,0,0" Text="Köşedeki Başlat veya Kapat düğmesine giderken yanlışlıkla geçmezsiniz."/>
     <TextBlock Text="Geçiş tuşu" Style="{StaticResource Label}"/>
     <WrapPanel>
      <RadioButton x:Name="KeyNone" GroupName="SwitchKey" Content="Gerekmez" Checked="Option_Changed"/>
      <RadioButton x:Name="KeyShift" GroupName="SwitchKey" Content="Shift basılıyken geç" Checked="Option_Changed"/>
      <RadioButton x:Name="KeyCtrl" GroupName="SwitchKey" Content="Ctrl basılıyken geç" Checked="Option_Changed"/>
      <RadioButton x:Name="KeyAlt" GroupName="SwitchKey" Content="Sol Alt basılıyken geç" Checked="Option_Changed"/>
     </WrapPanel>
     <TextBlock Text="Kenara çift dokunma" Style="{StaticResource Label}"/>
     <WrapPanel>
      <RadioButton x:Name="TapOff" GroupName="DoubleTap" Content="Kapalı" Checked="Option_Changed"/>
      <RadioButton x:Name="TapOverride" GroupName="DoubleTap" Content="Engel varken çift dokunarak geç" Checked="Option_Changed"/>
      <RadioButton x:Name="TapAlways" GroupName="DoubleTap" Content="Her geçişte çift dokunma iste" Checked="Option_Changed"/>
     </WrapPanel>
     <TextBlock Style="{StaticResource Note}" Text="Kenara dokunun, imleci biraz geri çekin ve yarım saniye içinde yeniden dokunun."/>
     <TextBlock Text="Bu programlar öndeyken geçme" Style="{StaticResource Label}"/>
     <DockPanel>
      <Button x:Name="AddProgramButton" DockPanel.Dock="Right" Content="Açık programlardan ekle" Style="{StaticResource Secondary}" Margin="10,6,0,10" Click="AddProgram_Click"/>
      <TextBox x:Name="ProgramsBox" LostKeyboardFocus="Programs_LostFocus" KeyDown="Programs_KeyDown" AutomationProperties.Name="Geçişi engelleyen programlar"/>
     </DockPanel>
     <TextBlock Style="{StaticResource Note}" Margin="0" Text="Program adlarını virgülle ayırın, ör. oyun.exe, obs64.exe."/>
    </StackPanel></Border>

    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="Kısayollar" Style="{StaticResource Heading}"/>
     <TextBlock Style="{StaticResource Note}" Text="Kutuya tıklayıp tuş birleşimine basın; silmek için Delete. En az iki değiştirici gerekir: Ctrl, sol Alt veya Shift. AltGr kısayol sayılmaz, böylece @, # gibi karakterler etkilenmez."/>
     <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock Text="Kenardan geçişi aç/kapat" VerticalAlignment="Center"/>
      <TextBox x:Name="ToggleHotkeyBox" Grid.Column="1" Style="{StaticResource HotkeyBox}" Tag="Toggle" AutomationProperties.Name="Kenardan geçişi aç/kapat kısayolu"/>
      <TextBlock Grid.Row="1" Text="Sonraki bilgisayara geç" VerticalAlignment="Center"/>
      <TextBox x:Name="NextHotkeyBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource HotkeyBox}" Tag="Next" AutomationProperties.Name="Sonraki bilgisayar kısayolu"/>
      <TextBlock Grid.Row="2" Text="Bu bilgisayara dön" VerticalAlignment="Center"/>
      <TextBox x:Name="HomeHotkeyBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource HotkeyBox}" Tag="Home" AutomationProperties.Name="Bu bilgisayara dön kısayolu"/>
     </Grid>
     <TextBlock x:Name="HotkeyStatusText" Style="{StaticResource Note}" Foreground="{StaticResource Warning}" Visibility="Collapsed"/>
     <TextBlock Text="Monitöre atla" Style="{StaticResource Label}"/>
     <WrapPanel>
      <RadioButton x:Name="JumpOff" GroupName="Jump" Content="Kapalı" Checked="Option_Changed"/>
      <RadioButton x:Name="JumpCtrlAlt" GroupName="Jump" Content="Ctrl + sol Alt + rakam" Checked="Option_Changed"/>
      <RadioButton x:Name="JumpCtrlShift" GroupName="Jump" Content="Ctrl + Shift + rakam" Checked="Option_Changed"/>
     </WrapPanel>
     <TextBlock Style="{StaticResource Note}" Text="1 = A, 2 = B … Harfler Monitör düzeni sayfasındaki sırayı izler. Bağlı olmayan bilgisayarın monitörüne atlanmaz. @, # gibi karakterleri AltGr yerine Ctrl + sol Alt ile yazıyorsanız Ctrl + Shift'i seçin."/>
    </StackPanel></Border>

    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="Nasıl çalışır" Style="{StaticResource Heading}"/>
     <TextBlock Style="{StaticResource Note}" Text="• İmleci, monitör düzeninde diğer bilgisayara değen bir kenara itin. Klavye de imleçle birlikte geçer."/>
     <TextBlock Style="{StaticResource Note}" Text="• Esc tuşuna hızlıca iki kez basmak kontrolü bu bilgisayara geri getirir."/>
     <TextBlock Style="{StaticResource Note}" Text="• Kontrol edilen bilgisayarın kendi faresini oynatmak veya tıklamak kontrolü ona geri verir."/>
     <TextBlock Style="{StaticResource Note}" Text="• Fare düğmesi basılıyken geçiş yapılmaz; pencere sürüklerken yanlışlıkla geçmezsiniz."/>
     <TextBlock Style="{StaticResource Note}" Text="• Bağlantı koparsa, ekran kilitlenirse veya bilgisayar uykuya geçerse imleç bu bilgisayara döner ve basılı tuşlar bırakılır."/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="Sınırlar" Style="{StaticResource Heading}"/>
     <TextBlock Style="{StaticResource Note}" Text="Yönetici olarak çalışan pencereler, UAC ekranı, kilit ekranı ve Ctrl+Alt+Del bu sürümde uzaktan kontrol edilemez. ShareMouse gibi başka bir paylaşım uygulaması aynı anda açıksa kapatın."/>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>

   <ScrollViewer x:Name="UpdatesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,28,32,24">
    <TextBlock Text="Uygulama" Style="{StaticResource Title}"/>
    <TextBlock Style="{StaticResource Note}" Margin="0,6,0,20" Text="Arka planda çalışma, Windows ile başlatma ve güncellemeler."/>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="Arka planda çalışma" Style="{StaticResource Heading}"/>
     <TextBlock Style="{StaticResource Note}" Text="Pencereyi kapattığınızda Banko Share saatin yanındaki bildirim alanında çalışmaya devam eder; fare ve klavye paylaşımı sürer. Simgeye tıklayınca pencere açılır, sağ tıklayınca menü çıkar."/>
     <CheckBox x:Name="AutostartBox" Content="Windows açılınca başlat" Margin="0,14,0,0" Checked="Autostart_Changed" Unchecked="Autostart_Changed"/>
     <TextBlock x:Name="AutostartNote" Style="{StaticResource Note}" Margin="28,4,0,0"/>
     <Button Content="Banko Share'den çık" Style="{StaticResource Secondary}" Click="Exit_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/>
     <TextBlock Style="{StaticResource Note}" FontSize="12" Text="Çıkınca paylaşım durur; diğer bilgisayar bu bilgisayara geçemez."/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="Pano ve dosyalar" Style="{StaticResource Heading}"/>
     <TextBlock Style="{StaticResource Note}" Text="Kopyaladığınız şey imleçle birlikte diğer bilgisayara geçer; orada Ctrl+V ile yapıştırırsınız. İmleç geri gelince orada kopyaladığınız şey de buraya gelir."/>
     <CheckBox x:Name="ClipboardBox" Content="Panoyu paylaş (metin, biçimli metin, resim)" Margin="0,14,0,0" Checked="Option_Changed" Unchecked="Option_Changed"/>
     <CheckBox x:Name="FilesBox" Content="Kopyalanan dosya ve klasörleri de aktar" Margin="0,12,0,0" Checked="Option_Changed" Unchecked="Option_Changed"/>
     <TextBlock Style="{StaticResource Note}" Margin="28,4,0,0" Text="Dosyalar ayrı, şifreli bir bağlantıyla gider; büyük dosyalar fareyi yavaşlatmaz. Bir seferde en fazla 8 GB ve 50.000 öğe aktarılır. Büyük aktarımlarda bitince bildirim çıkar."/>
     <Button Content="Alınan dosyalar klasörü" Style="{StaticResource Secondary}" Click="OpenReceived_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
     <TextBlock Style="{StaticResource Note}" FontSize="12" Text="Gelen dosyalar yapıştırılana kadar burada bekler; üç günden eskiler silinir."/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="Tanılama" Style="{StaticResource Heading}"/>
     <TextBlock Style="{StaticResource Note}" Text="Banko Share bağlantıları, geçişleri, duraklatmaları ve yavaş girişleri bir kayıt dosyasına yazar; yazdığınız tuşları ve kopyaladığınız içeriği yazmaz. Bir sorun olduğunda diğer bilgisayarın kaydını da buraya alabilirsiniz."/>
     <WrapPanel Margin="0,4,0,0">
      <Button Content="Kayıt klasörünü aç" Style="{StaticResource Secondary}" Click="OpenLogs_Click"/>
      <Button Content="Diğer bilgisayarların kaydını al" Style="{StaticResource Secondary}" Click="FetchLogs_Click"/>
     </WrapPanel>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="Oyunlar ve hile önleme" Style="{StaticResource Heading}"/>
     <CheckBox x:Name="GamesBox" Content="Riot oyunu açıkken bu bilgisayarda paylaşımı duraklat (önerilir)" Margin="0,12,0,0" Checked="Option_Changed" Unchecked="Option_Changed"/>
     <TextBlock Style="{StaticResource Note}" Margin="28,4,0,0" Text="VALORANT ya da League of Legends oyunu açıkken Banko Share bu bilgisayarda fare ve klavye kancalarını kaldırır, hiçbir giriş göndermez ve diğer bilgisayara buraya geçmemesini bildirir. Oyunun sürecine hiç dokunmaz. Yalnızca Riot istemcisinin açık olması yetmez; oyun kapanınca Banko Share kendiliğinden devam eder."/>
     <TextBlock x:Name="GameStateText" Style="{StaticResource Note}" Margin="28,6,0,0" Foreground="{StaticResource Green}"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <DockPanel><TextBlock Text="Güncellemeler" Style="{StaticResource Heading}"/><TextBlock x:Name="UpdateVersionText" HorizontalAlignment="Right" Foreground="{StaticResource Green}"/></DockPanel>
     <TextBlock x:Name="UpdateStatus" Text="Güncelleme kontrolü bekleniyor." TextWrapping="Wrap" Margin="0,8,0,0"/>
     <TextBlock x:Name="LastCheckText" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,10"/>
     <CheckBox x:Name="AutoUpdate" Content="Güncellemeleri otomatik indir ve paylaşım yokken kur" Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed"/>
     <WrapPanel Margin="0,4,0,0"><Button x:Name="CheckUpdateButton" Content="Şimdi kontrol et" Click="CheckUpdate_Click"/><Button x:Name="ApplyUpdateButton" Content="Güncelle ve yeniden başlat" Click="ApplyUpdate_Click" IsEnabled="False"/></WrapPanel>
     <TextBlock Style="{StaticResource Note}" FontSize="12" Text="İmleç diğer bilgisayardayken veya son bir dakikada paylaşım yapıldıysa kurulum bekletilir."/>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>
  </Grid>

  <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource Base}" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="32,10">
   <DockPanel>
    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#5C5C5C" Margin="0,0,10,0" VerticalAlignment="Center"/>
    <TextBlock x:Name="NoticeText" DockPanel.Dock="Right" Foreground="{StaticResource Warning}" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="440" VerticalAlignment="Center"/>
    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
