<Window x:Class="BankoShare.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:BankoShare.App"
 Title="Banko Share" Width="1040" Height="720" MinWidth="860" MinHeight="600" WindowStartupLocation="CenterScreen"
 Background="#101827" Foreground="#EAF1FF" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#83E3CB"/>
  <SolidColorBrush x:Key="Muted" Color="#AABBD3"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,10,10,0"/><Setter Property="Background" Value="#83E3CB"/>
   <Setter Property="Foreground" Value="#101827"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.88"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#2A3A55"/><Setter Property="Foreground" Value="#EAF1FF"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,6,0,10"/><Setter Property="Background" Value="#202D42"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#40516B"/><Setter Property="CaretBrush" Value="White"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EAF1FF"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#1B293D"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Note" TargetType="TextBlock"><Setter Property="Foreground" Value="#AABBD3"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
  <Style x:Key="Nav" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#C9D6EA"/><Setter Property="FontSize" Value="15"/><Setter Property="Cursor" Value="Hand"/><Setter Property="GroupName" Value="Nav"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Box" CornerRadius="8" Padding="14,10" Margin="0,2" Background="Transparent"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#162133"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#1B293D"/><Setter Property="Foreground" Value="#83E3CB"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <Border Grid.RowSpan="2" Background="#0B111C">
   <DockPanel Margin="18,24,18,18">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="BANKO SHARE" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="13"/>
     <TextBlock x:Name="LocalNameText" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="12"/>
     <StackPanel Margin="0,24,0,0">
      <RadioButton x:Name="NavDevices" Style="{StaticResource Nav}" Content="Cihazlar" IsChecked="True" Checked="Nav_Checked"/>
      <RadioButton x:Name="NavLayout" Style="{StaticResource Nav}" Content="Monitör düzeni" Checked="Nav_Checked"/>
      <RadioButton x:Name="NavSwitching" Style="{StaticResource Nav}" Content="Geçiş ayarları" Checked="Nav_Checked"/>
      <RadioButton x:Name="NavUpdates" Style="{StaticResource Nav}" Content="Güncellemeler" Checked="Nav_Checked"/>
     </StackPanel>
    </StackPanel>
    <TextBlock VerticalAlignment="Bottom" Style="{StaticResource Note}" FontSize="12"
     Text="Esc tuşuna hızlıca iki kez basmak imleci ve klavyeyi bu bilgisayara geri getirir."/>
   </DockPanel>
  </Border>

  <Grid Grid.Column="1">
   <ScrollViewer x:Name="DevicesPanel" VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,28,32,24">
    <TextBlock Text="Cihazlar" Style="{StaticResource Title}"/>
    <TextBlock Style="{StaticResource Note}" Margin="0,6,0,20"
     Text="Fare ve klavyeyi paylaşan bilgisayarlar. Eşleştirme bir kez yapılır; sonra iki uygulama açıldığında kendiliğinden bağlanır."/>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="Bu bilgisayar" Style="{StaticResource Heading}"/>
     <TextBlock x:Name="LocalInfoText" Style="{StaticResource Note}"/>
     <TextBlock x:Name="WarningText" Foreground="#F6C177" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="Eşleşmiş cihazlar" Style="{StaticResource Heading}"/>
     <StackPanel x:Name="PeersPanel" Margin="0,10,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Bu bilgisayarı ekle" Style="{StaticResource Heading}"/>
      <TextBlock Style="{StaticResource Note}" Text="Kodu gösterin ve diğer bilgisayardaki Banko Share'e girin. Kod 5 dakika geçerlidir ve bir kez kullanılır."/>
      <Button x:Name="ShowCodeButton" Content="Eşleştirme kodu göster" Click="ShowCode_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
      <StackPanel x:Name="CodePanel" Visibility="Collapsed" Margin="0,14,0,0">
       <Border Background="#0B111C" CornerRadius="8" Padding="14,10" HorizontalAlignment="Left">
        <TextBox x:Name="PairCodeText" IsReadOnly="True" FontFamily="Consolas" FontSize="24" FontWeight="Bold" Foreground="#83E3CB"
         Background="Transparent" BorderThickness="0" Padding="0" Margin="0" AutomationProperties.Name="Eşleştirme kodu"/>
       </Border>
       <TextBlock x:Name="PairExpiryText" Style="{StaticResource Note}"/>
       <Button Content="Kodu iptal et" Style="{StaticResource Secondary}" Click="CancelCode_Click" HorizontalAlignment="Left"/>
      </StackPanel>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="Diğer bilgisayarı ekle" Style="{StaticResource Heading}"/>
      <TextBlock Text="Ağda bulunan Banko Share cihazları" Style="{StaticResource Note}"/>
      <ListBox x:Name="DiscoveredList" Height="92" Margin="0,6,0,0" SelectionChanged="Discovered_Selected"
       Background="#202D42" Foreground="#EAF1FF" BorderBrush="#40516B"/>
      <TextBlock Text="IP adresi" Margin="0,10,0,0"/>
      <TextBox x:Name="AddressBox" AutomationProperties.Name="Diğer bilgisayarın IP adresi"/>
      <TextBlock Text="Diğer bilgisayarda görünen kod"/>
      <TextBox x:Name="CodeBox" FontFamily="Consolas" CharacterCasing="Upper" AutomationProperties.Name="Eşleştirme kodu girişi"/>
      <Button x:Name="PairButton" Content="Eşleştir" Click="Pair_Click" HorizontalAlignment="Left" Margin="0,0,10,0"/>
      <TextBlock x:Name="PairStatusText" Style="{StaticResource Note}"/>
     </StackPanel>
    </Grid></Border>
   </StackPanel></ScrollViewer>

   <Grid x:Name="LayoutPanel" Visibility="Collapsed" Margin="32,28,32,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="Monitör düzeni" Style="{StaticResource Title}"/>
     <TextBlock Style="{StaticResource Note}" Margin="0,6,0,16"
      Text="Monitörleri masanızdaki yerleşime göre sürükleyin. Bir bilgisayarın monitörleri birlikte taşınır ve yakındaki kenara yapışır. İmleç, birbirine değen kenarlardan diğer bilgisayara geçer."/>
    </StackPanel>
    <local:LayoutEditor x:Name="Editor" Grid.Row="1" MinHeight="260"/>
    <DockPanel Grid.Row="2" Margin="0,12,0,0">
     <Button DockPanel.Dock="Right" Content="Düzeni sıfırla" Style="{StaticResource Secondary}" Click="ResetLayout_Click" Margin="10,0,0,0" VerticalAlignment="Top"/>
     <StackPanel>
      <TextBlock x:Name="LayoutHintText" Style="{StaticResource Note}" Margin="0"/>
      <TextBlock Style="{StaticResource Note}" FontSize="12"><Run Foreground="#83E3CB" Text="■"/> Bu bilgisayar   <Run Foreground="#7C93E6" Text="■"/> Bağlı   <Run Foreground="#5A6B85" Text="■"/> Bağlı değil</TextBlock>
     </StackPanel>
    </DockPanel>
   </Grid>

   <ScrollViewer x:Name="SwitchingPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,28,32,24">
    <TextBlock Text="Geçiş ayarları" Style="{StaticResource Title}"/>
    <Border Style="{StaticResource Card}" Margin="0,20,0,16"><StackPanel>
     <CheckBox x:Name="SwitchingBox" Content="Ekran kenarından diğer bilgisayara geç" FontSize="15" Checked="Switching_Changed" Unchecked="Switching_Changed"/>
     <TextBlock Style="{StaticResource Note}" Margin="24,4,0,0" Text="Kapalıyken imleç bu bilgisayarda kalır; bağlantılar açık kalır ve diğer bilgisayar buraya geçebilir."/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="Nasıl çalışır" Style="{StaticResource Heading}"/>
     <TextBlock Style="{StaticResource Note}" Text="• İmleci, monitör düzeninde diğer bilgisayara değen bir kenara itin. Klavye de imleçle birlikte geçer."/>
     <TextBlock Style="{StaticResource Note}" Text="• Esc tuşuna hızlıca iki kez basmak kontrolü bu bilgisayara geri getirir."/>
     <TextBlock Style="{StaticResource Note}" Text="• Kontrol edilen bilgisayarın kendi faresini oynatmak veya tıklamak kontrolü ona geri verir."/>
     <TextBlock Style="{StaticResource Note}" Text="• Fare düğmesi basılıyken geçiş yapılmaz; pencere sürüklerken yanlışlıkla geçmezsiniz."/>
     <TextBlock Style="{StaticResource Note}" Text="• Bağlantı koparsa, ekran kilitlenirse veya bilgisayar uykuya geçerse imleç bu bilgisayara döner ve basılı tuşlar bırakılır."/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="Sınırlar" Style="{StaticResource Heading}"/>
     <TextBlock Style="{StaticResource Note}" Text="Yönetici olarak çalışan pencereler, UAC ekranı, kilit ekranı ve Ctrl+Alt+Del bu sürümde uzaktan kontrol edilemez. ShareMouse gibi başka bir paylaşım uygulaması aynı anda açıksa kapatın."/>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>

   <ScrollViewer x:Name="UpdatesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,28,32,24">
    <TextBlock Text="Güncellemeler" Style="{StaticResource Title}"/>
    <Border Style="{StaticResource Card}" Margin="0,20,0,16"><StackPanel>
     <DockPanel><TextBlock Text="Banko Share" Style="{StaticResource Heading}"/><TextBlock x:Name="UpdateVersionText" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/></DockPanel>
     <TextBlock x:Name="UpdateStatus" Text="Güncelleme kontrolü bekleniyor." TextWrapping="Wrap" Margin="0,8,0,0"/>
     <TextBlock x:Name="LastCheckText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,8"/>
     <CheckBox x:Name="AutoUpdate" Content="Güncellemeleri otomatik indir ve paylaşım yokken kur" Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed"/>
     <WrapPanel><Button x:Name="CheckUpdateButton" Content="Şimdi kontrol et" Click="CheckUpdate_Click"/><Button x:Name="ApplyUpdateButton" Content="Güncelle ve yeniden başlat" Click="ApplyUpdate_Click" IsEnabled="False"/></WrapPanel>
     <TextBlock Style="{StaticResource Note}" FontSize="12" Text="İmleç diğer bilgisayardayken veya son bir dakikada paylaşım yapıldıysa kurulum bekletilir."/>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>
  </Grid>

  <Border Grid.Column="1" Grid.Row="1" Background="#0B111C" Padding="32,10">
   <DockPanel>
    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#3A4458" Margin="0,0,10,0" VerticalAlignment="Center"/>
    <TextBlock x:Name="NoticeText" DockPanel.Dock="Right" Foreground="#F6C177" TextTrimming="CharacterEllipsis" MaxWidth="440" VerticalAlignment="Center"/>
    <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
